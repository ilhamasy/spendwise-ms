# Environment Mode
APP_ENV=production
GIN_MODE=release

# Server
HOST=0.0.0.0
PORT=8080

# PostgreSQL Production Database
DB_HOST=your-production-db-host.postgres.database.azure.com
DB_PORT=5432
DB_USER=spendwise_prod_user
DB_PASSWORD=your-secure-production-db-password
DB_NAME=spendwise_prod_db
DB_SSLMODE=require

# JWT Secret (Production - Must use a strong 64-character random string)
JWT_SECRET=change-this-to-a-strong-random-64-character-secret-in-production

# Google OAuth (Production Credentials)
GOOGLE_CLIENT_ID=your-production-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-production-google-client-secret

# Redis (Production Cache / Rate Limiting)
REDIS_ADDR=your-production-redis-host:6379
