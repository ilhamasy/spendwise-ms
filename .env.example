# Environment Mode (local | production)
APP_ENV=local
GIN_MODE=debug

# Server
HOST=127.0.0.1
PORT=8080

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=spendwise
DB_PASSWORD=spendwise
DB_NAME=spendwise_main_db
DB_SSLMODE=disable

# JWT
JWT_SECRET=test-jwt-secret-for-local-development

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Redis (optional)
# REDIS_ADDR=localhost:6379
